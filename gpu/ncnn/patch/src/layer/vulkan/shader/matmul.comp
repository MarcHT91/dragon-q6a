// Batched MatMul, elempack 1, vec4 loads. Each invocation computes 4 rows (m) x 4 cols (n).
// Accumulates in afp (fp16 when fp16 arithmetic is on): ~1-2% relative error over K=1024 (fp32 sums: TODO).
#version 450

layout(constant_id = 0) const int transB = 0;

layout(binding = 0) readonly buffer A_blob { sfpvec4 A_blob_data[]; };
layout(binding = 1) readonly buffer B_blob { sfpvec4 B_blob_data[]; };
layout(binding = 2) writeonly buffer top_blob { sfpvec4 top_blob_data[]; };

layout(push_constant) uniform parameter
{
    int M;
    int N;
    int K;
    int acstep;
    int bcstep;
    int ocstep;
} p;

void main()
{
    const int gx = int(gl_GlobalInvocationID.x);
    const int gy = int(gl_GlobalInvocationID.y);
    const int gz = int(gl_GlobalInvocationID.z);

    const int N4 = p.N / 4;
    const int K4 = p.K / 4;
    if (gx >= N4 || gy * 4 >= p.M)
        return;

    const int m0 = gy * 4;
    const int r1 = min(m0 + 1, p.M - 1);
    const int r2 = min(m0 + 2, p.M - 1);
    const int r3 = min(m0 + 3, p.M - 1);

    // offsets in vec4 units
    const int aoff = gz * p.acstep / 4;
    const int boff = gz * p.bcstep / 4;
    const int ooff = gz * p.ocstep / 4;

    const int a0i = aoff + m0 * K4;
    const int a1i = aoff + r1 * K4;
    const int a2i = aoff + r2 * K4;
    const int a3i = aoff + r3 * K4;

    afpvec4 sum0 = afpvec4(0.f);
    afpvec4 sum1 = afpvec4(0.f);
    afpvec4 sum2 = afpvec4(0.f);
    afpvec4 sum3 = afpvec4(0.f);

    if (transB == 0)
    {
        // B [K][N]: rows k..k+3, cols gx*4..gx*4+3
        int bi = boff + gx;
        for (int k4 = 0; k4 < K4; k4++)
        {
            afpvec4 a0 = buffer_ld4(A_blob_data, a0i + k4);
            afpvec4 a1 = buffer_ld4(A_blob_data, a1i + k4);
            afpvec4 a2 = buffer_ld4(A_blob_data, a2i + k4);
            afpvec4 a3 = buffer_ld4(A_blob_data, a3i + k4);

            afpvec4 b0 = buffer_ld4(B_blob_data, bi);
            afpvec4 b1 = buffer_ld4(B_blob_data, bi + N4);
            afpvec4 b2 = buffer_ld4(B_blob_data, bi + N4 * 2);
            afpvec4 b3 = buffer_ld4(B_blob_data, bi + N4 * 3);
            bi += N4 * 4;

            sum0 += a0.r * b0 + a0.g * b1 + a0.b * b2 + a0.a * b3;
            sum1 += a1.r * b0 + a1.g * b1 + a1.b * b2 + a1.a * b3;
            sum2 += a2.r * b0 + a2.g * b1 + a2.b * b2 + a2.a * b3;
            sum3 += a3.r * b0 + a3.g * b1 + a3.b * b2 + a3.a * b3;
        }
    }
    else
    {
        // B [N][K]: rows n = gx*4..gx*4+3
        const int b0i = boff + (gx * 4 + 0) * K4;
        const int b1i = boff + (gx * 4 + 1) * K4;
        const int b2i = boff + (gx * 4 + 2) * K4;
        const int b3i = boff + (gx * 4 + 3) * K4;
        for (int k4 = 0; k4 < K4; k4++)
        {
            afpvec4 a0 = buffer_ld4(A_blob_data, a0i + k4);
            afpvec4 a1 = buffer_ld4(A_blob_data, a1i + k4);
            afpvec4 a2 = buffer_ld4(A_blob_data, a2i + k4);
            afpvec4 a3 = buffer_ld4(A_blob_data, a3i + k4);

            afpvec4 b0 = buffer_ld4(B_blob_data, b0i + k4);
            afpvec4 b1 = buffer_ld4(B_blob_data, b1i + k4);
            afpvec4 b2 = buffer_ld4(B_blob_data, b2i + k4);
            afpvec4 b3 = buffer_ld4(B_blob_data, b3i + k4);

            sum0 += afpvec4(dot(a0, b0), dot(a0, b1), dot(a0, b2), dot(a0, b3));
            sum1 += afpvec4(dot(a1, b0), dot(a1, b1), dot(a1, b2), dot(a1, b3));
            sum2 += afpvec4(dot(a2, b0), dot(a2, b1), dot(a2, b2), dot(a2, b3));
            sum3 += afpvec4(dot(a3, b0), dot(a3, b1), dot(a3, b2), dot(a3, b3));
        }
    }

    const int oi = ooff + m0 * N4 + gx;
    buffer_st4(top_blob_data, oi, sum0);
    if (m0 + 1 < p.M) buffer_st4(top_blob_data, oi + N4, sum1);
    if (m0 + 2 < p.M) buffer_st4(top_blob_data, oi + N4 * 2, sum2);
    if (m0 + 3 < p.M) buffer_st4(top_blob_data, oi + N4 * 3, sum3);
}
